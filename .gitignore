node_modules/
dist/
.local/
.env*
*.local.*
test-results/
.claude/worktrees/
# Staged from @par/xr-workspace by scripts/prepare-assets.ts
public/fonts/
public/assets/xr-hands/
public/vendor/
__pycache__/
# Reproduced byte for byte by scripts/assets/build_materials.py
assets-source/materials/derived/*.png
assets-source/materials/checks/
# Reproduced byte for byte by scripts/assets/build_audio.py
assets-source/audio/derived/*.wav
# Reproduced by scripts/assets/build-room-study.py (dev-only inputs for ?tex=png and compare_engine.py)
assets-source/rooms/*/staging/renders/*.png
assets-source/rooms/*/staging/*.png
*.blend1
# Per-run Blender logs carry absolute paths
assets-source/**/staging/build.log
# Raw card provider downloads live on parnas1 (D21); hashes in assets-source/cards/raw-store.json
assets-source/cards/*/**/*.png
!assets-source/cards/foundry/guards.png
!assets-source/cards/foundry/strikes.png
# Reproducible alchemy-kit intermediates. The packed source and selected review renders are tracked.
assets-source/props/alchemy-kit/staging/*.glb
assets-source/props/alchemy-kit/staging/*.png
!assets-source/props/alchemy-kit/staging/review*.png

# Embedded archive PBR maps and the intermediate export are reproduced by the Blender generator.
assets-source/props/archive-kit/staging/*.glb
assets-source/props/archive-kit/staging/*.png
!assets-source/props/archive-kit/staging/review*.png
# Commission maps and staging export are packed in the editable Blender source.
assets-source/props/commission-kit/staging/*.glb
assets-source/props/commission-kit/staging/*.png
!assets-source/props/commission-kit/staging/review*.png

# Original calibration maps and the intermediate GLB are reproduced by the Blender generator.
assets-source/props/calibration-kit/staging/*.glb
assets-source/props/calibration-kit/staging/*.png
!assets-source/props/calibration-kit/staging/review*.png
# Source textures are packed in the panel blend. Only authored review renders are tracked.
assets-source/props/panel-kit/staging/*.glb
assets-source/props/panel-kit/staging/*.png
!assets-source/props/panel-kit/staging/review*.png
# Reproducible packed brass-key texture maps and intermediate export.
assets-source/props/brass-key-kit/staging/*-base.png
assets-source/props/brass-key-kit/staging/*-normal.png
assets-source/props/brass-key-kit/staging/*-orm.png
assets-source/props/brass-key-kit/staging/*.glb
