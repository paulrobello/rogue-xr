{
  "name": "rogue-xr",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "scripts": {
    "prep": "bun scripts/prepare-assets.ts",
    "dev": "bun run prep && vite --host 0.0.0.0 --port 4260 --strictPort",
    "build": "bun run prep && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 4261 --strictPort",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "biome check .",
    "fmt": "biome format --write ."
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "0.21.0",
    "@par/xr-workspace": "file:../mux-xr/packages/xr-workspace",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "26.6.4",
    "@types/three": "0.186.0",
    "@types/webxr": "0.5.24",
    "fake-indexeddb": "6.2.8",
    "happy-dom": "21.0.4",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.3"
  }
}
